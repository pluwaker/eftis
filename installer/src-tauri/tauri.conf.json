{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eftis Setup",
  "version": "2.0.0",
  "identifier": "com.eftis.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Eftis Setup",
        "width": 780,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0c0d0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
